@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<header>
    <nav>
        <p>MRSINAF</p>
        <ul>
            <li class="nav-link">
                <NavLink href="/" ActiveClass="nav-link--active"
                         Match="NavLinkMatch.All">
                    Accueil
                </NavLink>
            </li>
            <li class="nav-link">
                <NavLink href="/projects" ActiveClass="nav-link--active"
                         Match="NavLinkMatch.All">
                    Projets
                </NavLink>
            </li>
            <li class="nav-link">
                <NavLink href="/blogs" ActiveClass="nav-link--active"
                         Match="NavLinkMatch.All">
                    Blogs
                </NavLink>
            </li>
            <li class="nav-link">
                <NavLink href="/warhammer" ActiveClass="nav-link--active"
