@page "/warhammer"
@using Microsoft.EntityFrameworkCore
@using Sinaf.Me.Components.Customs
@using Sinaf.Me.Data
@using Sinaf.Me.Data.Warhammer
<PageTitle>Warhammer</PageTitle>

<main>
    <h1>Warhammer</h1>
    <section id="clans">
        @if (clans is not null)
        {
            @foreach (var clan in clans)
            {
                <a href="/warhammer/clans/@clan.UniqueName">
                    <h2>@clan.Name</h2>
                    <p>@($"> {clan.Race.Name} <")</p>
                </a>
            }
        }
        else
        {
            <Loading/>
        }
    </section>
    <section id="categories">
        <a href="/warhammer/gallery/">
            Galerie
        </a>
        <a href="/warhammer/citations/">
            Citations
        </a>
        @* <a href="/warhammer/battle-reports/"> *@
        @*     Rapports de bataille *@
        @* </a> *@
    </section>
    @if (image is not null)
    {
        <section id="news">
            <h2>Dernière création</h2>
            <img src=@image.Path alt="@image.Id"/>
        </section>
    }
</main>

@code {
    private Image? image;
    private Clan[]? clans;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await using var context = new WarhammerDbContext();
        clans = [await context.Clans.Include(x => x.Race).FirstAsync()];
        image = await context.Images.OrderByDescending(x => x.Id).FirstOrDefaultAsync();
        StateHasChanged();
    }

}