@page "/blogs/{id:int}"
@using Microsoft.EntityFrameworkCore
@using Sinaf.Me.Components.Customs
@using Sinaf.Me.Data
@using Sinaf.Me.Data.Web

@if (notFound)
{
    <div id="error">
        <p>Oups... Le blog #@Id.ToString("###-###-###") est introuvable...</p>
    </div>
}
else if (blog is null)
{
    <PageTitle>Blog #@Id</PageTitle>
    <Loading/>
}
else
{
    <PageTitle>@blog.Title</PageTitle>
    <main>
        <BlogViewer Blog="blog"></BlogViewer>
    </main>
}

@code {
    [Parameter] public int Id { get; set; }
    private Blog? blog;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        await using var context = new WebDbContext();
        blog = await context.Blogs.FirstOrDefaultAsync(x => x.Id == Id && x.Published);
        notFound = blog is null;
    }

}