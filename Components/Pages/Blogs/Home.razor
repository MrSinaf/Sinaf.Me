@page "/blogs"
@using Sinaf.Me.Components.Customs
@namespace Sinaf.Me.Components.Pages.Blogs

<PageTitle>Blogs</PageTitle>

<main>
    <h1>Blogs</h1>
    @if (blogs is not null)
    {
        @if (!blogs.Any())
        {
            <p>Aucun blog pour le moment...</p>
        }
        else
        {
            @foreach (var blog in blogs)
            {
                <a href="/blogs/@blog.Id">
                    <img src="blogs/@blog.Id/thumbnail.png" alt="thumbnail"/>
                    <div>
                        <h2>@blog.Title</h2>
                        <hr/>
                        <p>@(blog.Content)...</p>
                        <span>@blog.PublishAt?.ToString("dd/MM/yyyy")</span>
                    </div>
                </a>
            }
        }
    }
    else
    {
        <Loading/>
    }
</main>